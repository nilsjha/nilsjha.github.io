---
const slideIt = {
  old: {
    name: "slideOut",
    duration: "0.5s",
    easing: "ease-out",
    fillMode: "forwards",
  },
  new: {
    name: "slideIn",
    duration: "0.5s",
    easing: "ease-in",
    fillMode: "backwards",
  },
};

const menuFx = {
  forwards: slideIt,
  backwards: slideIt,
};
---

<ul
  role="list"
  class="md:grid md:w-184 md:max-w-full md:grid-cols-[13rem_minmax(0,1fr)] md:gap-x-8"
  transition:name="menu-list"
  transition:animate={menuFx}
>
  <slot />
</ul>

<style>
  @keyframes slideIn {
    from {
      transform: translateY(-15%);
      filter: blur(100px) opacity(10%);
    }

    to {
      transform: translateY(0%);
    }
  }
  @keyframes slideOut {
    from {
      transform: translateY(0%);
    }

    to {
      transform: translateY(10%);
      filter: blur(100px) opacity(10%);
    }
  }
</style>
