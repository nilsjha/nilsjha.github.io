---
interface Props {
  framesource: string;
  height?: number;
  width?: number;
  title?: string;
  description?: string;
  href?: string;
}

// The archive.org DOSBox embed renders a fixed 640x480 canvas, so the frame
// keeps that size and is zoomed uniformly to fit the stage.
const {
  framesource,
  height = 480,
  width = 640,
  title,
  description,
} = Astro.props;
---

<div class="md:hidden uppercase text-slate-700 pt-4 text-center">
  <h1 class="text-3xl text-cyan-800">warning</h1>
  mobile browsers <span class="text-slate-600">*will*</span>
  not work
</div>

<div data-game-stage class="relative w-full grow min-h-60">
  <div
    class="absolute inset-0 flex items-center justify-center overflow-hidden"
  >
    <iframe
      class="block"
      src={framesource}
      width={width}
      height={height}
      frameborder="0"
      webkitallowfullscreen="true"
      mozallowfullscreen="true"
      allowfullscreen
    >
    </iframe>
  </div>
</div>

<script>
  let observers: ResizeObserver[] = [];

  function fit(stage: HTMLElement) {
    const frame = stage.querySelector("iframe");
    if (!frame) return;
    const zoom = Math.min(
      stage.clientWidth / Number(frame.width),
      stage.clientHeight / Number(frame.height),
    );
    frame.style.zoom = String(Math.max(zoom, 0.25));
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-game-stage]")
      .forEach((stage) => {
        const observer = new ResizeObserver(() => fit(stage));
        observer.observe(stage);
        observers.push(observer);
      });
  });

  document.addEventListener("astro:before-swap", () => {
    observers.forEach((observer) => observer.disconnect());
    observers = [];
  });
</script>
