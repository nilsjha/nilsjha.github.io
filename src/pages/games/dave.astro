---
import Layout from "@layouts/Layout.astro";
import MenuEntry from "@components/MenuEntry.astro";
import Banner from "@components/Banner.astro";
import Game from "@components/Game.astro";
import Footer from "@components/Footer.astro";
---

<Layout title="Dangerous Dave">
  <main class="grow flex flex-col w-full py-2">
    <div class="grow flex flex-col items-center gap-2">
      <Game framesource="https://archive.org/embed/dangerous_dave_1990" />
    </div>
  </main>
  <Footer home={true} separator={true}>
    <span
      ><a
        class="_hotlink"
        target="_blank"
        href="https://archive.org/details/dangerous_dave_1990"
        >internet archive</a
      ></span
    >
    <span
      ><a class="_hotlink" href="#fullscreen" role="button" data-game-fullscreen
        >fullscreen</a
      ></span
    >
  </Footer>
</Layout>
