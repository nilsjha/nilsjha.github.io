---
import Layout from "@layouts/Layout.astro";
import Game from "@components/Game.astro";
import Footer from "@components/Footer.astro";
---

<Layout title="Outrun">
  <main class="grow flex flex-col w-full py-2">
    <div class="grow flex flex-col items-center gap-2">
      <Game framesource="https://archive.org/embed/Outrun_DOS" />
    </div>
  </main>
  <Footer home={true} separator={true}>
    <span
      ><a
        class="_hotlink"
        target="_blank"
        href="https://archive.org/details/Outrun_DOS">internet archive</a
      ></span
    >
    <span
      ><a class="_hotlink" href="#fullscreen" role="button" data-game-fullscreen
        >fullscreen</a
      ></span
    >
  </Footer>
</Layout>
